#!/bin/bash
# Build Wispr from source, bundle into Wispr.app, and install.
# Usage: bash REBUILD
set -e
cd "$(dirname "$0")"

VERSION=$(grep 'version = ' Sources/OpenWisprLib/Version.swift | sed 's/.*"\(.*\)".*/\1/')

echo "===== 1. build (release) ====="
swift build -c release 2>&1 | grep -E "error:|Build complete|Compiling wispr" || true
# Re-run cleanly to surface errors if the pipe swallowed them
swift build -c release
echo "build OK."

echo ""
echo "===== 2. bundle Wispr.app ====="
bash scripts/bundle-app.sh \
    .build/release/wispr \
    /tmp/Wispr-build.app \
    "$VERSION"
echo "bundle OK."

echo ""
echo "===== 3. install to /Applications ====="
pkill -x "Wispr" 2>/dev/null || true
pkill -f "wispr" 2>/dev/null || true
sleep 0.5
rm -rf "/Applications/Wispr.app"
cp -R /tmp/Wispr-build.app "/Applications/Wispr.app"
rm -rf /tmp/Wispr-build.app
echo "installed."

echo ""
echo "===== 4. strip resource forks + codesign ====="
WISPR_KEYCHAIN="$HOME/Library/Keychains/wispr-signing.keychain-db"
KEYCHAIN_PASS="wispr-dev"
xattr -cr "/Applications/Wispr.app"
SIGN_HASH=""
if [ -f "$WISPR_KEYCHAIN" ]; then
    security unlock-keychain -p "$KEYCHAIN_PASS" "$WISPR_KEYCHAIN" 2>/dev/null || true
    SIGN_HASH=$(security find-identity -v -p codesigning "$WISPR_KEYCHAIN" 2>/dev/null \
        | awk '/Wispr Dev Signing/{print $2; exit}')
fi
if [ -n "$SIGN_HASH" ]; then
    codesign --force --deep --sign "$SIGN_HASH" \
      --requirements "=designated => identifier \"com.hull.wispr\"" \
      "/Applications/Wispr.app" && echo "signed OK (persistent identity: $SIGN_HASH)."
else
    echo "WARNING: 'Wispr Dev Signing' cert not found — using ad-hoc signing."
    echo "Run 'bash scripts/setup-signing.sh' once to fix Keychain prompts."
    codesign --force --deep --sign - \
      --requirements "=designated => identifier \"com.hull.wispr\"" \
      "/Applications/Wispr.app" && echo "signed OK (ad-hoc)."
fi

echo ""
echo "===== 5. install LaunchAgent ====="
PLIST_SRC="$(pwd)/com.hull.wispr.plist"
PLIST_DST="$HOME/Library/LaunchAgents/com.hull.wispr.plist"
if [ -f "$PLIST_SRC" ]; then
    launchctl unload "$PLIST_DST" 2>/dev/null || true
    cp "$PLIST_SRC" "$PLIST_DST"
    launchctl load "$PLIST_DST"
    echo "LaunchAgent installed."
else
    echo "(No LaunchAgent plist found — skipping. Run once manually to generate.)"
fi

echo ""
echo "===== 6. verify running ====="
sleep 2
if pgrep -qf "wispr"; then
    echo "running (started by LaunchAgent)."
else
    echo "WARNING: app didn't start — check Console for crash logs."
fi

echo ""
echo "DONE."
echo "If this is a first install, go to:"
echo "  System Settings → Privacy & Security → Accessibility → Wispr → ON"
echo "  System Settings → Privacy & Security → Microphone → Wispr → ON"
